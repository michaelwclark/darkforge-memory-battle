# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local credentials — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state and contestant persistence. Ignore everything under data/
# EXCEPT the held-out Track C question sets — those are small, hand-authored,
# and version-controlled as part of the published benchmark.
data/*
!data/darkforge/
data/darkforge/*
!data/darkforge/questions_v*.json

# Run logs (large, regenerated per run; JSON in results/ is the citeable source)
logs/
# Orchestrator tick logs live under logs/ too; explicit for clarity.
logs/orchestrator_*.log

# Orchestrator-driven pending-publications digest (human/Claude consumes + clears)
PENDING_PUBLICATIONS.md

# OS
.DS_Store
Thumbs.db
